---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/admin.css';

const posts = await getCollection('posts');
const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))].sort();

const maxPostNum = posts.reduce((max, post) => {
  const match = post.id.match(/^post(\d+)/);
  if (!match) return max;
  return Math.max(max, Number(match[1]));
}, 0);

const siteConfig = {
  owner: 'SakanactionQAQ',
  repo: 'myblog',
  branch: 'main',
  postsDir: 'src/content/posts',
  nextPostNum: maxPostNum + 1,
  categories,
};
---

<BaseLayout title="写文章 · 管理后台" showHomeLink={true}>
  <section class="admin-page" id="admin-app" data-config={JSON.stringify(siteConfig)}>
    <div class="admin-login" id="login-panel">
      <h1>管理后台</h1>
      <p class="admin-lead">
        使用具有本仓库写权限的 GitHub Token 登录后，可在线撰写并发布 Markdown 文章。
        Token 只保存在本机浏览器会话中，不会写入网站。
      </p>

      <form id="login-form" class="admin-form">
        <label>
          <span>GitHub Personal Access Token</span>
          <input
            type="password"
            id="token-input"
            name="token"
            autocomplete="off"
            placeholder="github_pat_… 或 ghp_…"
            required
          />
        </label>
        <p class="admin-hint">
          推荐创建
          <a href="https://github.com/settings/personal-access-tokens" target="_blank" rel="noopener">
            Fine-grained token
          </a>
          ，仅授权本仓库 <code>Contents: Read and write</code>。
        </p>
        <button type="submit" class="admin-btn primary">登录</button>
        <p class="admin-status" id="login-status" hidden></p>
      </form>
    </div>

    <div class="admin-editor" id="editor-panel" hidden>
      <div class="admin-editor-header">
        <div>
          <h1>写新文章</h1>
          <p class="admin-lead">发布后将提交到 GitHub，并由 Actions 自动构建上线（约 1–2 分钟）。</p>
        </div>
        <button type="button" class="admin-btn ghost" id="logout-btn">退出登录</button>
      </div>

      <form id="post-form" class="admin-form">
        <div class="admin-grid">
          <label>
            <span>标题</span>
            <input type="text" id="title-input" name="title" required placeholder="文章标题" />
          </label>

          <label>
            <span>分类</span>
            <input
              type="text"
              id="category-input"
              name="category"
              list="category-list"
              required
              placeholder="例如：机器学习"
            />
            <datalist id="category-list">
              {categories.map((category) => <option value={category} />)}
            </datalist>
          </label>

          <label>
            <span>发布日期</span>
            <input type="date" id="date-input" name="pubdate" required />
          </label>

          <label>
            <span>文件名（可选）</span>
            <input
              type="text"
              id="filename-input"
              name="filename"
              placeholder="留空则自动生成，如 post11-标题.md"
            />
          </label>
        </div>

        <label>
          <span>摘要（可选）</span>
          <input type="text" id="abstract-input" name="abstract" placeholder="列表页展示的短摘要" />
        </label>

        <label>
          <span>正文（Markdown，支持数学公式）</span>
          <textarea
            id="body-input"
            name="body"
            rows="18"
            required
            placeholder={"支持 Markdown 与 KaTeX，例如：\n\n## 小节\n\n公式 $E=mc^2$"}
          ></textarea>
        </label>

        <div class="admin-actions">
          <button type="submit" class="admin-btn primary" id="publish-btn">发布文章</button>
          <p class="admin-status" id="publish-status" hidden></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    const STORAGE_KEY = 'myblog_admin_github_token';

    const app = document.getElementById('admin-app');
    const config = JSON.parse(app.dataset.config);

    const loginPanel = document.getElementById('login-panel');
    const editorPanel = document.getElementById('editor-panel');
    const loginForm = document.getElementById('login-form');
    const postForm = document.getElementById('post-form');
    const tokenInput = document.getElementById('token-input');
    const loginStatus = document.getElementById('login-status');
    const publishStatus = document.getElementById('publish-status');
    const logoutBtn = document.getElementById('logout-btn');
    const publishBtn = document.getElementById('publish-btn');
    const dateInput = document.getElementById('date-input');

    dateInput.value = new Date().toISOString().slice(0, 10);

    function setStatus(el, message, type = 'info') {
      el.hidden = !message;
      el.textContent = message || '';
      el.dataset.type = type;
    }

    function getToken() {
      return sessionStorage.getItem(STORAGE_KEY) || '';
    }

    function setToken(token) {
      sessionStorage.setItem(STORAGE_KEY, token);
    }

    function clearToken() {
      sessionStorage.removeItem(STORAGE_KEY);
    }

    function showEditor() {
      loginPanel.hidden = true;
      editorPanel.hidden = false;
    }

    function showLogin() {
      editorPanel.hidden = true;
      loginPanel.hidden = false;
    }

    async function githubFetch(path, token, options = {}) {
      const response = await fetch(`https://api.github.com${path}`, {
        ...options,
        headers: {
          Accept: 'application/vnd.github+json',
          Authorization: `Bearer ${token}`,
          'X-GitHub-Api-Version': '2022-11-28',
          ...(options.headers || {}),
        },
      });

      let data = null;
      const text = await response.text();
      if (text) {
        try {
          data = JSON.parse(text);
        } catch {
          data = { message: text };
        }
      }

      if (!response.ok) {
        const message = data?.message || `GitHub API 错误（${response.status}）`;
        throw new Error(message);
      }

      return data;
    }

    async function verifyToken(token) {
      const repo = await githubFetch(`/repos/${config.owner}/${config.repo}`, token);
      // permissions may be absent for some token types; publish will still enforce write access
      if (repo?.permissions && repo.permissions.push === false) {
        throw new Error('当前 Token 对该仓库没有写权限');
      }
    }

    function sanitizeFilenamePart(title) {
      return title
        .trim()
        .replace(/[\\/:*?"<>|]/g, '')
        .replace(/\s+/g, '_')
        .slice(0, 60);
    }

    function buildMarkdown({ title, pubdate, category, abstract, body }) {
      const lines = [
        '---',
        `title: '${title.replace(/'/g, "''")}'`,
        `pubdate: ${pubdate}`,
      ];

      if (abstract?.trim()) {
        lines.push(`abstract: '${abstract.trim().replace(/'/g, "''")}'`);
      }

      lines.push(`category: '${category.replace(/'/g, "''")}'`);
      lines.push('---', '', body.trim(), '');
      return lines.join('\n');
    }

    function toBase64(text) {
      const bytes = new TextEncoder().encode(text);
      let binary = '';
      bytes.forEach((b) => {
        binary += String.fromCharCode(b);
      });
      return btoa(binary);
    }

    function contentsApiPath(filePath) {
      return `/repos/${config.owner}/${config.repo}/contents/${filePath
        .split('/')
        .map(encodeURIComponent)
        .join('/')}`;
    }

    async function fileExists(token, filePath) {
      const response = await fetch(
        `https://api.github.com${contentsApiPath(filePath)}?ref=${encodeURIComponent(config.branch)}`,
        {
          headers: {
            Accept: 'application/vnd.github+json',
            Authorization: `Bearer ${token}`,
            'X-GitHub-Api-Version': '2022-11-28',
          },
        },
      );

      if (response.status === 404) return false;
      if (response.ok) return true;

      const err = await response.json().catch(() => ({}));
      throw new Error(err.message || `检查文件失败（${response.status}）`);
    }

    async function publishPost(token, formData) {
      const title = formData.get('title').toString().trim();
      const category = formData.get('category').toString().trim();
      const pubdate = formData.get('pubdate').toString().trim();
      const abstract = formData.get('abstract').toString();
      const body = formData.get('body').toString();
      let filename = formData.get('filename').toString().trim();

      if (!filename) {
        filename = `post${config.nextPostNum}-${sanitizeFilenamePart(title)}.md`;
      }
      if (!filename.endsWith('.md')) {
        filename += '.md';
      }

      const path = `${config.postsDir}/${filename}`;
      if (await fileExists(token, path)) {
        throw new Error(`文件已存在：${filename}，请更换文件名`);
      }

      const markdown = buildMarkdown({ title, pubdate, category, abstract, body });

      await githubFetch(contentsApiPath(path), token, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: `publish: ${title}`,
          content: toBase64(markdown),
          branch: config.branch,
        }),
      });

      config.nextPostNum += 1;
      return { filename, path };
    }

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const token = tokenInput.value.trim();
      setStatus(loginStatus, '正在验证 Token…', 'info');

      try {
        await verifyToken(token);
        setToken(token);
        tokenInput.value = '';
        setStatus(loginStatus, '');
        showEditor();
      } catch (error) {
        setStatus(
          loginStatus,
          error instanceof Error ? error.message : '登录失败',
          'error',
        );
      }
    });

    logoutBtn.addEventListener('click', () => {
      clearToken();
      showLogin();
      setStatus(loginStatus, '已退出登录', 'info');
    });

    postForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const token = getToken();
      if (!token) {
        showLogin();
        setStatus(loginStatus, '登录已失效，请重新登录', 'error');
        return;
      }

      publishBtn.disabled = true;
      setStatus(publishStatus, '正在提交到 GitHub…', 'info');

      try {
        const result = await publishPost(token, new FormData(postForm));
        setStatus(
          publishStatus,
          `已发布 ${result.filename}。GitHub Actions 构建完成后即可在网站看到新文章。`,
          'success',
        );
        postForm.reset();
        dateInput.value = new Date().toISOString().slice(0, 10);
      } catch (error) {
        setStatus(
          publishStatus,
          error instanceof Error ? error.message : '发布失败',
          'error',
        );
      } finally {
        publishBtn.disabled = false;
      }
    });

    // Restore session
    (async () => {
      const token = getToken();
      if (!token) return;
      try {
        await verifyToken(token);
        showEditor();
      } catch {
        clearToken();
      }
    })();
  </script>
</BaseLayout>
